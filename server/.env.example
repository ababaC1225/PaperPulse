PORT=3000
PAPERPULSE_DB_PATH=./data/paperpulse.db
PAPERPULSE_USER_AGENT=PaperPulseCourseProject/1.0 (+https://example.edu/paperpulse; educational metadata client)
PAPERPULSE_HTTP_TIMEOUT_MS=12000
PAPERPULSE_HTTP_CONCURRENCY=3
PAPERPULSE_HTTP_INTERVAL_MS=1500
PAPERPULSE_HTTP_RETRIES=2
PAPERPULSE_HTTP_BACKOFF_MS=400
PAPERPULSE_CACHE_TTL_SECONDS=86400
PAPERPULSE_RESPECT_ROBOTS=true
PAPERPULSE_ENABLED_SOURCES=cvf,ecva,dblp
PAPERPULSE_SOURCE_YEARS=2021,2022,2023,2024,2025
PAPERPULSE_MAX_SEARCH_RESULTS=20
PAPERPULSE_CANDIDATE_TTL_SECONDS=3600
PAPERPULSE_IMPORT_CONCURRENCY=2
PAPERPULSE_MAX_BATCH_SIZE=500
PAPERPULSE_GENERAL_STOPWORDS=a,an,and,are,as,at,be,by,for,from,in,is,of,on,or,that,the,this,to,with
PAPERPULSE_CV_STOPWORDS=approach,experiment,experiments,method,methods,model,models,paper,result,results,study,system
PAPERPULSE_SYNONYMS={"vlm":"vision language model","vision-language":"vision language","3-d":"3d"}
